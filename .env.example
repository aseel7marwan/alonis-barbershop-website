###########################################################
# Aloni's Barbershop — Deployment Environment Variables   #
# Copy this file to ".env" and fill in real credentials.  #
###########################################################

# Full path to WinSCP.com (required on your machine; not stored in repo). Example:
# DEPLOY_WINSCP_EXE=C:\Program Files (x86)\WinSCP\WinSCP.com
DEPLOY_WINSCP_EXE=

# SFTP host (hostname or IP)
DEPLOY_SFTP_HOST=your.sftp.host.example

# SFTP username
DEPLOY_SFTP_USER=your_sftp_username

# SFTP password (never commit .env)
DEPLOY_SFTP_PASS=your_sftp_password

# Remote directory on the server after login (e.g. /html or /public_html)
# Use "." for the default directory your SFTP user lands in.
DEPLOY_SFTP_REMOTE_DIR=.

# Server host key fingerprint for strict security (recommended), or "*" (less secure)
# Example (RSA): ssh-rsa 2048 xx:xx:...
DEPLOY_SFTP_HOSTKEY=*

