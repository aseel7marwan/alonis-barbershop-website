###########################################################
# Aloni's Barbershop — Deployment Environment Variables   #
# Copy this file to ".env" and fill in real credentials.  #
###########################################################

# SFTP host (e.g. sftp.your-host.de or IP)
DEPLOY_SFTP_HOST=your_host_address

# SFTP username
DEPLOY_SFTP_USER=your_username

# SFTP password (keep this secret; do NOT commit .env)
DEPLOY_SFTP_PASS=your_password

# Optional: server host key fingerprint for strict security
# Example (RSA): ssh-rsa 2048 xx:xx:...
# If unsure, you can temporarily use "*" but it is less secure.
DEPLOY_SFTP_HOSTKEY=*

